# =============================================================================
# Plantilla de variables de entorno (.env.example)
# Copiar a `.env` solo si deseas personalizar credenciales o puertos locales:
#   cp .env.example .env
# NOTA: No subas archivos `.env` reales con secretos de produccion a Git.
# =============================================================================

POSTGRES_DB=sistema_escolar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PostgresRootDev2026!
POSTGRES_PORT=5432

# Clave simetrica para pgp_sym_encrypt / pgp_sym_decrypt (AES-256)
APP_ENCRYPTION_KEY=ClaveMaestraEscolar_Dev2026!

# Etiqueta opcional de imagen (util para publicar en Docker Hub)
DOCKER_IMAGE=sistema-escolar-db:v1
